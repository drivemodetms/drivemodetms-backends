# Drive Mode TMS Backend Configuration
# Copy this file to .env and fill in your actual values

# Node environment
NODE_ENV=production
PORT=3000

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database
# Examples:
#   Local: postgresql://postgres:password@localhost:5432/drivemodetms
#   Supabase: postgresql://postgres:password@db.supabase.co:5432/postgres
#   AWS RDS: postgresql://admin:password@instance.rds.amazonaws.com:5432/drivemodetms
DATABASE_URL=postgresql://user:password@localhost:5432/drivemodetms

# JWT Secret (change this to a random string in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend URL (for CORS)
FRONTEND_URL=https://drivemodetms.com

# AWS S3 (for document storage — optional for now)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=drivemodetms-documents
